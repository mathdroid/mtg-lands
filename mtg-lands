#!/usr/bin/env python3
"""
mtg-lands - classify and rank the dual/fixing lands for any color identity.

Wraps `scry search --json` (the scry CLI). For a color identity it pulls every
Commander-legal land whose color identity fits and that can produce the colors,
then for each land records:
  - entry status (untapped / conditional / tapped), read from the oracle text;
  - cycle (true dual, shock, check, verge, filter, ...), or "-" if it is a
    one-off / not a recognized named cycle;
  - tags (searchable, filter, pain, lifegain, manland, MDFC, cycling, snow,
    scry, surveil, bounce, storage).

Output groups the identity-specific lands into three tables by entry status,
ordered within each by a popularity+price score. Any-color (rainbow) lands tap
for any color and are listed separately.

A 3-color identity is the union of its three pairs plus a full-triple query,
which also pulls in trilands.

Usage:
  mtg-lands rg                 # one pair (letters or guild name: rg / gruul)
  mtg-lands bant               # one triple (letters or shard/wedge: gur / temur)
  mtg-lands --all-pairs        # all 10 guilds
  mtg-lands --all-triples      # all 10 shards/wedges
  mtg-lands rg --generic       # also expand the any-color (rainbow) lands
  mtg-lands rg --json          # machine-readable classification

Requires the `scry` binary on PATH (or set SCRY_BIN).
"""

import json
import os
import re
import subprocess
import sys
import time

SCRY_BIN = os.environ.get("SCRY_BIN", "scry")

# Small courtesy gap between scry calls so batch runs don't burst. scry itself
# backs off and retries on a 429, so this only has to avoid the obvious bursts.
_MIN_INTERVAL = 0.1
_last_call = [0.0]

WUBRG = "wubrg"
BASIC = {"w": "plains", "u": "island", "b": "swamp", "r": "mountain", "g": "forest"}
BASIC_WORDS = set(BASIC.values())

GUILDS = {
    "wu": "Azorius", "ub": "Dimir", "br": "Rakdos", "rg": "Gruul", "gw": "Selesnya",
    "wb": "Orzhov", "ur": "Izzet", "bg": "Golgari", "rw": "Boros", "gu": "Simic",
}
TRIOMES = {
    "gwu": "Bant", "wub": "Esper", "ubr": "Grixis", "brg": "Jund", "rgw": "Naya",
    "wbg": "Abzan", "urw": "Jeskai", "bgu": "Sultai", "rwb": "Mardu", "gur": "Temur",
}
NAME_TO_KEY = {}
for k, v in list(GUILDS.items()) + list(TRIOMES.items()):
    NAME_TO_KEY[v.lower()] = k


def canon_colors(s):
    """Return a canonical WUBRG-ordered color string from letters or a name."""
    s = s.strip().lower()
    if s in NAME_TO_KEY:
        s = NAME_TO_KEY[s]
    letters = [c for c in s if c in WUBRG]
    seen = []
    for c in WUBRG:
        if c in letters and c not in seen:
            seen.append(c)
    return "".join(seen)


def combo_name(colors):
    return GUILDS.get(colors) or TRIOMES.get(colors) or colors.upper()


# ---------------------------------------------------------------------------
# Scryfall fetch (via the scry CLI)
# ---------------------------------------------------------------------------

def scry_search(query):
    wait = _MIN_INTERVAL - (time.time() - _last_call[0])
    if wait > 0:
        time.sleep(wait)
    _last_call[0] = time.time()
    try:
        out = subprocess.run(
            [SCRY_BIN, "search", query, "--json"],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        sys.exit("error: `%s` not found. Install scry or set SCRY_BIN." % SCRY_BIN)
    if out.returncode != 0:
        sys.exit("scry failed: %s" % (out.stderr.strip() or out.stdout.strip()))
    return json.loads(out.stdout or "[]")


def pair_query(colors):
    prod = ",".join(colors)
    return "f:c t:land id:%s produces:%s" % (colors, prod)


def fetch_lands(colors):
    """Return deduped card list for a pair or triple identity."""
    if len(colors) <= 2:
        cards = scry_search(pair_query(colors))
    else:
        # triple = union of its 3 pairs (the 2-color duals + rainbow), PLUS a
        # query at the full triple identity (trilands and other lands that make
        # all 3 colors, whose 3-color identity is excluded by the pair queries).
        seen, cards = set(), []
        queries = [pair_query(colors[i] + colors[j])
                   for i in range(len(colors))
                   for j in range(i + 1, len(colors))]
        queries.append(pair_query(colors))  # produces all three
        for q in queries:
            for c in scry_search(q):
                oid = c.get("oracle_id") or c.get("name")
                if oid not in seen:
                    seen.add(oid)
                    cards.append(c)
    return cards


# ---------------------------------------------------------------------------
# Card helpers
# ---------------------------------------------------------------------------

def oracle(c):
    if c.get("oracle_text"):
        return c["oracle_text"]
    return " // ".join(f.get("oracle_text", "") for f in c.get("card_faces", []))


def type_line(c):
    return c.get("type_line", "")


def produced(c):
    return set(x for x in c.get("produced_mana", []) if x.lower() in WUBRG)


def basic_types_in(tl):
    low = tl.lower()
    return [w for w in BASIC_WORDS if re.search(r"\b%s\b" % w, low)]


def price(c):
    p = c.get("prices", {}) or {}
    for k in ("usd", "usd_foil", "usd_etched"):
        v = p.get(k)
        if v:
            try:
                return float(v)
            except ValueError:
                pass
    return None


def edhrec(c):
    return c.get("edhrec_rank") or 10 ** 9


# ---------------------------------------------------------------------------
# Classification: entry status (untapped/conditional/tapped), cycle, and tags.
# ---------------------------------------------------------------------------

def is_dfc(c):
    return len(c.get("card_faces", [])) >= 2 and " // " in type_line(c)


def both_faces_land(c):
    faces = c.get("card_faces", [])
    return len(faces) == 2 and all("land" in f.get("type_line", "").lower() for f in faces)


def has_filter(text, c):
    raw = oracle(c).lower()
    cols = sorted(x.lower() for x in produced(c))
    if len(cols) != 2:
        return False
    a, b = cols
    if ("{%s/%s}" % (a, b)) in raw or ("{%s/%s}" % (b, a)) in raw:
        return True
    # old filters: "{1}, {t}: add {a}{b}" style
    return bool(re.search(r"\{1\},?\s*\{t\}:\s*add \{[wubrg]\}\{[wubrg]\}", raw))


def is_rainbow(text, c):
    if len(produced(c)) >= 4:
        return True
    for kw in ("any color", "any type", "any one color", "combination of colors",
               "mana of any"):
        if kw in text:
            return True
    return False


# Recognized land cycles, as (name, predicate(name_lower, text_lower, type_lower,
# card)). First match wins, so specific/named cycles come before broad ones.
# Named cycles (Verge, Campus, Triome, Pathway, Guildgate, Bridge, Temple,
# Tainted) are matched by card name, which is far more reliable than text
# heuristics and avoids over-matching look-alikes (e.g. Nimbus Maze is not a
# Verge). Cards that match nothing get cycle "-".
CYCLES = [
    ("Triland", lambda n, t, tl, c: len(produced(c)) == 3 and not is_rainbow(t, c)),
    ("Pathway", lambda n, t, tl, c: "pathway" in n or (is_dfc(c) and both_faces_land(c))),
    ("MDFC spell/land", lambda n, t, tl, c: is_dfc(c) and not both_faces_land(c)),
    # named cycles, matched by card name
    ("Verge", lambda n, t, tl, c: n.endswith(" verge")),
    ("Tainted", lambda n, t, tl, c: n.startswith("tainted ")),
    ("Campus", lambda n, t, tl, c: n.endswith(" campus")),
    ("Guildgate", lambda n, t, tl, c: "guildgate" in n
        or ("gate" in tl and "enters tapped" in t and len(t) < 120)),
    ("Bridge", lambda n, t, tl, c: n.endswith(" bridge")),
    # true dual: basic land types, no drawback text at all
    ("True dual", lambda n, t, tl, c: (
        len(basic_types_in(tl)) >= 2
        and not any(k in t for k in (
            "enters tapped", "pay", "damage", "gain", "unless", "cycling",
            "sacrifice", "reveal", "counter", "scry", "surveil")))),
    ("Shock", lambda n, t, tl, c: len(basic_types_in(tl)) >= 2 and "pay 2 life" in t),
    ("Battle/Tango", lambda n, t, tl, c: "two or more basic lands" in t),
    ("Check", lambda n, t, tl, c: "enters tapped unless you control a" in t
        and any(w in t for w in BASIC_WORDS)),
    ("Fast", lambda n, t, tl, c: "two or fewer other lands" in t),
    ("Slow", lambda n, t, tl, c: "two or more other lands" in t),
    ("Catch-up", lambda n, t, tl, c: "unless your opponents control" in t),
    ("Pain", lambda n, t, tl, c: "deals 1 damage to you" in t and "add {c}" in t),
    ("Filter", lambda n, t, tl, c: has_filter(t, c)),
    ("Bond (crowd)", lambda n, t, tl, c: "two or more opponents" in t),
    ("Horizon/Canopy", lambda n, t, tl, c: "pay 1 life" in t and "draw a card" in t and "sacrifice" in t),
    ("Reverse-pain", lambda n, t, tl, c: "each opponent gains 1 life" in t),
    ("Reveal", lambda n, t, tl, c: "you may reveal a" in t
        and any(w in t for w in BASIC_WORDS) and "enters tapped" in t),
    # Surveil land = MKM dual (basic types + on-enter surveil), kept apart from
    # the weak Campus lands' {4},{T}: Surveil ability.
    ("Surveil land", lambda n, t, tl, c: len(basic_types_in(tl)) >= 2
        and "surveil" in t and "enters tapped" in t),
    # Scry/Temple = Theros Temples: on-enter scry (not Campus' {4},{T}: Scry).
    ("Scry/Temple", lambda n, t, tl, c: n.startswith("temple of")
        or "when this land enters, scry 1" in t),
    ("Creature land", lambda n, t, tl, c: "becomes a" in t and "creature" in t),
    ("Bounce/Karoo", lambda n, t, tl, c: "return a land you control to its owner" in t),
    ("Gain/Refuge", lambda n, t, tl, c: "enters tapped" in t and "gain 1 life" in t),
    ("Cycling/Bicycle", lambda n, t, tl, c: "cycling" in t and len(basic_types_in(tl)) >= 2),
    ("Snow dual", lambda n, t, tl, c: "snow" in tl),
    ("Storage", lambda n, t, tl, c: "storage counter" in t),
    ("Depletion", lambda n, t, tl, c: "depletion counter" in t),
    ("Locked", lambda n, t, tl, c: "doesn't untap during your" in t),
]


def classify(c):
    """Return the recognized cycle name, or '-' if none matches."""
    n = c.get("name", "").lower()
    t = oracle(c).lower()
    tl = type_line(c).lower()
    for name, pred in CYCLES:
        try:
            if pred(n, t, tl, c):
                return name
        except Exception:
            continue
    return "-"


def entry_status(c):
    """How the land enters: 'untapped', 'conditional', or 'tapped'.

    Read straight from the oracle text: a land that can enter tapped is
    'conditional' if it offers a way to enter untapped (pay life / a control
    condition / reveal), otherwise it is unconditionally 'tapped'.
    """
    t = oracle(c).lower()
    tapped = "enters tapped" in t or "enters the battlefield tapped" in t
    if not tapped:
        return "untapped"
    if ("unless" in t) or ("if you don't" in t) or ("you may pay 2 life" in t):
        return "conditional"
    return "tapped"


def tags(c):
    """Orthogonal mechanical tags for a land (independent of cycle)."""
    t = oracle(c).lower()
    tl = type_line(c).lower()
    out = []
    if basic_types_in(tl):
        out.append("searchable")        # has basic land types -> fetchable
    if has_filter(t, c):
        out.append("filter")
    if "deals 1 damage to you" in t:
        out.append("pain")
    if "gain 1 life" in t:
        out.append("lifegain")
    if "becomes a" in t and "creature" in t:
        out.append("manland")
    if is_dfc(c):
        out.append("MDFC")
    if "cycling" in t:
        out.append("cycling")
    if "snow" in tl:
        out.append("snow")
    if "scry" in t:
        out.append("scry")
    if "surveil" in t:
        out.append("surveil")
    if "return a land you control to its owner" in t:
        out.append("bounce")
    if "storage counter" in t:
        out.append("storage")
    return out


# ---------------------------------------------------------------------------
# Scoring: percentile combo of popularity (EDHREC) and price, within the set.
# Used only to order cards inside each entry-status table.
# ---------------------------------------------------------------------------

def score_cards(cards):
    n = len(cards)
    if n == 0:
        return
    by_rank = sorted(cards, key=edhrec)
    rpos = {id(c): i for i, c in enumerate(by_rank)}
    priced = [c for c in cards if price(c) is not None]
    bp = sorted(priced, key=price)
    ppos = {id(c): i for i, c in enumerate(bp)}
    m = len(bp)
    for c in cards:
        rpct = 1 - (rpos[id(c)] / (n - 1)) if n > 1 else 1.0
        if price(c) is None or m <= 1:
            ppct = rpct  # no price data: lean on popularity, don't penalize
        else:
            ppct = ppos[id(c)] / (m - 1)
        c["_score"] = round(0.5 * rpct + 0.5 * ppct, 3)


# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------

def fmt_price(c):
    p = price(c)
    return "n/a" if p is None else "$%.2f" % p


ENTRY_ORDER = ["untapped", "conditional", "tapped"]
ENTRY_LABEL = {
    "untapped": "Enters untapped",
    "conditional": "Conditional (untapped only if a condition is met)",
    "tapped": "Enters tapped",
}


def build(colors):
    cards = fetch_lands(colors)
    score_cards(cards)
    for c in cards:
        c["_generic"] = is_rainbow(oracle(c).lower(), c)
        c["_cycle"] = classify(c)
        c["_entry"] = entry_status(c)
        c["_tags"] = tags(c)
    return cards


def render(colors, cards, show_generic):
    lines = []
    name = combo_name(colors)
    generic = [c for c in cards if c["_generic"]]
    specific = [c for c in cards if not c["_generic"]]
    lines.append("# %s (%s) - %d lands (%d %s-specific, %d any-color)" % (
        name, colors.upper(), len(cards), len(specific),
        colors.upper(), len(generic)))
    lines.append("")

    for entry in ENTRY_ORDER:
        group = [c for c in specific if c["_entry"] == entry]
        if not group:
            continue
        group.sort(key=lambda c: -c["_score"])
        lines.append("## %s" % ENTRY_LABEL[entry])
        lines.append("")
        lines.append("| Cycle | Card | Tags |")
        lines.append("|---|---|---|")
        for c in group:
            lines.append("| %s | %s | %s |" % (
                c["_cycle"], c["name"], ", ".join(c["_tags"])))
        lines.append("")

    lines.append("## Any-color (generic fixing, usable outside %s)  (%d cards)"
                 % (name, len(generic)))
    generic.sort(key=lambda c: -c["_score"])
    shown = generic if show_generic else generic[:8]
    lines.append("")
    lines.append("| Card | Entry | Tags |")
    lines.append("|---|---|---|")
    for c in shown:
        lines.append("| %s | %s | %s |" % (c["name"], c["_entry"], ", ".join(c["_tags"])))
    if not show_generic and len(generic) > 8:
        lines.append("| ... (%d more, use --generic) | | |" % (len(generic) - 8))
    lines.append("")
    return "\n".join(lines)


def as_json(colors, cards):
    out = []
    for c in cards:
        out.append({
            "name": c["name"],
            "colors": colors,
            "generic": c["_generic"],
            "entry": c["_entry"],
            "cycle": c["_cycle"],
            "tags": c["_tags"],
            "score": c.get("_score"),
            "edhrec_rank": None if edhrec(c) >= 10**9 else edhrec(c),
            "price_usd": price(c),
            "produced": sorted(produced(c)),
        })
    return out


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    flags = set(a for a in argv if a.startswith("--"))
    show_generic = "--generic" in flags
    want_json = "--json" in flags

    targets = []
    if "--all-pairs" in flags:
        targets = list(GUILDS.keys())
    elif "--all-triples" in flags:
        targets = list(TRIOMES.keys())
    elif args:
        targets = [canon_colors(a) for a in args]
    else:
        sys.exit(__doc__.strip())

    all_json = []
    for i, colors in enumerate(targets):
        if not colors:
            continue
        cards = build(colors)
        if want_json:
            all_json.append({"identity": colors, "cards": as_json(colors, cards)})
        else:
            if i:
                print("\n" + "=" * 72 + "\n")
            print(render(colors, cards, show_generic))
    if want_json:
        print(json.dumps(all_json, indent=2))


if __name__ == "__main__":
    main(sys.argv[1:])
